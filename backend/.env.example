# Copy to .env for local development. NEVER commit the real .env.
PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/etutor?retryWrites=true&w=majority
# Use a long random value, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# Frontend URL(s) allowed to call this API (comma-separated)
CLIENT_URL=http://localhost:5173
# Optional: password for demo accounts created by `npm run seed`
# SEED_PASSWORD=Demo@12345
